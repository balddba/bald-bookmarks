DB_DRIVER=sqlite
SQLITE_PATH=backend/bald_bookmarks/data/bookmarks.db
# For Oracle, set DB_DRIVER=oracle and fill in placeholders:
ORACLE_USER=bookmarks
ORACLE_PASSWORD=changeme
ORACLE_DSN=localhost:1521/FREEPDB1
# For PostgreSQL, set DB_DRIVER=postgres and fill in placeholders:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bookmarks
POSTGRES_PASSWORD=changeme
POSTGRES_DATABASE=bald_bookmarks
# For MySQL, set DB_DRIVER=mysql and fill in placeholders:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=bookmarks
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=bald_bookmarks
JOB_POLL_SECONDS=5
JOB_MAX_ATTEMPTS=3
MEDIA_ROOT=backend/bald_bookmarks/media
CORS_ORIGINS=http://localhost:5173
THUMBNAIL_VIEWPORT_WIDTH=1280
THUMBNAIL_VIEWPORT_HEIGHT=720
THUMBNAIL_TIMEOUT_MS=20000
# Required in Docker; optional locally if Chromium sandbox fails
THUMBNAIL_NO_SANDBOX=false
